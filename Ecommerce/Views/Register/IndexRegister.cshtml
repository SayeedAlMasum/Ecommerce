@model List<Ecommerce.Models.UserInfo>
@{
	ViewData["Title"] = "All Users";
}
<div class="container mt-5">
	<h2 class="mb-4">All Users</h2>

	<table class="table table-bordered table-striped">
		<thead>
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Role</th>
				
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.Name</td>
					<td>@user.Email</td>
					<td>@user.Role</td>
				</tr>
			}
		</tbody>
	</table>
</div>